<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="default">

    <!-- ============ Lighting & physics (same as test_world) ============ -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==============================================================
         Arena layout, 12m (x: -6..6) x 10m (y: -5..5), robot spawns at
         the origin (0,0) in the open middle room.

           MAZE ROOM   |   OPEN ROOM (spawn)   |  SLALOM + GOAL ROOM
           x -6..-2    |      x -2..2          |     x  2..6
           zig-zag     |  scattered pillars    |  zig-zag + crates
           corridor    |                       |  in the goal alcove

         Each side room connects to the middle room through a 1m gap
         centred on y=0 in its divider wall.
         ============================================================== -->

    <model name="arena_walls">
      <static>1</static>

      <!-- Outer boundary -->
      <link name="wall_north">
        <pose>0 5 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12.24 0.12 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.24 0.12 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="wall_south">
        <pose>0 -5 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>12.24 0.12 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.24 0.12 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="wall_east">
        <pose>6 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.12 10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 10 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="wall_west">
        <pose>-6 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.12 10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 10 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <!-- Divider between maze room and open room (x=-2), 1m gate at y=0 -->
      <link name="divider1_upper">
        <pose>-2 2.75 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 4.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 4.5 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="divider1_lower">
        <pose>-2 -2.75 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 4.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 4.5 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <!-- Divider between open room and slalom/goal room (x=2), 1m gate at y=0 -->
      <link name="divider2_upper">
        <pose>2 2.75 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 4.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 4.5 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="divider2_lower">
        <pose>2 -2.75 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 4.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 4.5 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <!-- Zig-zag maze baffles (left room), alternating from the west wall
           and the divider so the robot has to snake back and forth -->
      <link name="maze_baffle_1">
        <pose>-4.9 3.2 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.12 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.12 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="maze_baffle_2">
        <pose>-3.1 1.0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.12 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.12 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="maze_baffle_3">
        <pose>-4.9 -1.2 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.12 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.12 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="maze_baffle_4">
        <pose>-3.1 -3.4 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.12 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.12 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

      <!-- Slalom baffles (right room), before the goal alcove -->
      <link name="slalom_baffle_1">
        <pose>3.1 3.0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.12 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.12 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="slalom_baffle_2">
        <pose>4.9 0.5 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.12 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.12 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="slalom_baffle_3">
        <pose>3.1 -2.5 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.2 0.12 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.12 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>

    </model>

    <!-- ============ Scattered pillars in the open middle room ============ -->
    <model name="pillar_1">
      <static>1</static>
      <pose>-0.8 3.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>1</static>
      <pose>1.0 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>1</static>
      <pose>-0.5 -1.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>
    <model name="pillar_4">
      <static>1</static>
      <pose>0.8 -2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>
    <model name="pillar_5">
      <static>1</static>
      <pose>0 -3.8 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ============ Crates in the goal alcove (top-right corner) ============ -->
    <model name="crate_1">
      <static>1</static>
      <pose>5.3 4.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="crate_2">
      <static>1</static>
      <pose>4.6 4.4 0 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.4 0.4 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -14 12 0 0.7 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
